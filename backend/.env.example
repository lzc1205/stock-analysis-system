# ===== 数据库配置 =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=stock_warehouse

# ===== Redis 配置 =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== AI 大模型配置（豆包为例） =====
LLM_API_KEY=your_doubao_api_key
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL_NAME=ep-2024xxx  # 豆包模型端点ID

# ===== 数据采集配置 =====
# Tushare token（可选，不填则仅使用 Baostock + AkShare）
TUSHARE_TOKEN=

# ===== 服务配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# ===== 定时任务配置 =====
# 每日数据采集时间（24小时制）
COLLECT_HOUR=17
COLLECT_MINUTE=0